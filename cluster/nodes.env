# Inventaire du cluster, lu par les scripts de ce dossier.
# Les noms sont des alias SSH du poste d'administration (voir docs/cluster.md).

MANAGER=manager
WORKERS="worker1 worker2"

# Adresse fixe annoncee par le manager aux autres noeuds.
MANAGER_IP=10.96.253.211

# Etiquettes de placement : tier=data porte la base et le bus,
# tier=app les services sans etat et le cache.
NOEUD_DATA=worker1
NOEUDS_APP="manager worker2"

REGISTRY_HOST=registry.local

# --- pare-feu (cluster/25-parefeu.sh) --------------------------------------
IP_manager=10.96.253.211
IP_worker1=10.96.253.212
IP_worker2=10.96.253.213
# Seule source autorisee a ouvrir une session SSH : le routeur du reseau,
# par lequel passe le poste d'administration (ProxyJump).
ADMIN_SRC=10.96.253.254
BASTION=router
# Ports que les noeuds tier=app peuvent joindre sur le noeud tier=data, a
# travers le reseau overlay : PostgreSQL, AMQP, API d'administration du bus,
# puis les trois sources d'indicateurs lues par Prometheus (bus, machine,
# conteneurs).
PORTS_DATA="5432, 5672, 15672, 15692, 9100, 8080"
