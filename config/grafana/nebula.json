  },
  {
   "id": 7,
   "title": "Workers à l'écoute",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rabbitmq_queue_consumers{queue=\"publications\"}",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "description": "Instances de worker-medias connectées à la file publications. Attendu : 2."
  },
  {
   "id": 8,
   "type": "row",
   "title": "Point d'entrée (edge)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "title": "Requêtes par seconde, par service",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(sum by (service) (rate(traefik_service_requests_total[1m])), \"service\", \"$1\", \"service\", \"(.*)@swarm\")",
     "legendFormat": "{{service}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "title": "Erreurs par seconde, par service et code",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(sum by (service, code) (rate(traefik_service_requests_total{code=~\"[45]..\"}[1m])), \"service\", \"$1\", \"service\", \"(.*)@swarm\")",
     "legendFormat": "{{service}} {{code}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Réponses 4xx et 5xx. Vide quand tout va bien."
  },
  {
   "id": 11,
   "title": "Durée de réponse, 95e centile",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[1m]))), \"service\", \"$1\", \"service\", \"(.*)@swarm\")",
     "legendFormat": "{{service}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "95 % des requêtes sont servies en moins que cette durée."
  },
  {
   "id": 12,
   "type": "row",
   "title": "Services",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "title": "Instances par service et version",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (service, version) (count by (service, version, name) (label_replace(label_replace((time() - container_last_seen{container_label_com_docker_swarm_service_name=~\"nebula_(comptes|publications|worker-medias)\"}) < 60, \"version\", \"$1\", \"image\", \"^[^@]*:([^:@/]+)(@.*)?$\"), \"service\", \"$1\", \"container_label_com_docker_swarm_service_name\", \"nebula_(.*)\")))",
     "legendFormat": "{{service}} {{version}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 45,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "lineInterpolation": "stepAfter"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Pendant une mise à jour, les instances de l'ancienne version cèdent la place à celles de la nouvelle, une par une."
  },
  {
   "id": 14,
   "title": "Mémoire par service",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container_label_com_docker_swarm_service_name) (max by (container_label_com_docker_swarm_service_name, name) (container_memory_working_set_bytes{container_label_com_docker_swarm_service_name!=\"\"} and on (name) ((time() - container_last_seen{container_label_com_docker_swarm_service_name!=\"\"}) < 60)))",
     "legendFormat": "{{container_label_com_docker_swarm_service_name}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 15,
   "title": "Processeur par service",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (container_label_com_docker_swarm_service_name) (max by (container_label_com_docker_swarm_service_name, name) (rate(container_cpu_usage_seconds_total{container_label_com_docker_swarm_service_name!=\"\"}[2m]) and on (name) ((time() - container_last_seen{container_label_com_docker_swarm_service_name!=\"\"}) < 60)))",
     "legendFormat": "{{container_label_com_docker_swarm_service_name}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "En cœurs de processeur utilisés."
  },
  {
   "id": 16,
   "type": "row",
   "title": "Machines",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 17,
   "title": "Processeur utilisé",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - avg by (nodename) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m]) * on (instance) group_left (nodename) node_uname_info))",
     "legendFormat": "{{nodename}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 18,
   "title": "Mémoire utilisée",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nodename) (100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * on (instance) group_left (nodename) node_uname_info)",
     "legendFormat": "{{nodename}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 19,
   "title": "Disque utilisé",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nodename) (100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * on (instance) group_left (nodename) node_uname_info)",
     "legendFormat": "{{nodename}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "0",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
